{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun .claude/hooks/session-start.ts", "timeout": 300 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|MultiEdit|Write", "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun .claude/hooks/guard-files.ts" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun .claude/hooks/guard-commands.ts" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|MultiEdit|Write", "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun .claude/hooks/lint-file.ts", "timeout": 120 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun .claude/hooks/check-before-stop.ts", "timeout": 300 }] }
    ]
  }
}
