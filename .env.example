# Copy to .env and fill in. Never commit .env; never put a real secret in this file.

# Seals the session cookie. Any 32+ character random string locally.
# In production this comes from the account Secrets Store, not from here.
NUXT_SESSION_PASSWORD=

# Seals access_profiles.encrypted_payload (D-127). A base64 AES-256 key, e.g.
# `openssl rand -base64 32`. A worker secret in production, generated once and never rotated
# casually: rotating it makes every stored profile unreadable.
NUXT_ACCESS_PROFILE_ENCRYPTION_KEY=

# Signs a reservation's QR token (D-108). A base64 HMAC key, e.g. `openssl rand -base64 32`.
# A worker secret in production. Rotating it invalidates every QR already sent.
NUXT_QR_TOKEN_SECRET=

# HMAC key material for the backstage board's join code (E-120). Any string locally, e.g.
# `openssl rand -base64 32`. A worker secret in production; never stored or logged.
NUXT_BACKSTAGE_BOARD_SECRET=

# Signs a waiting-list entry's claim and removal link (D-113). A base64 HMAC key, e.g.
# `openssl rand -base64 32`. A worker secret in production. Rotating it invalidates every
# outstanding offer and removal link already sent.
NUXT_WAITING_LIST_TOKEN_SECRET=

# The estate port map holds until cutover: stage-door 3000, this app 3001,
# rooms 3002, rehearsal 3003.
NUXT_PORT=3001

# Workspace-only Google sign-in (decision 0008). These names are nuxt-auth-utils'
# own; it reads them directly, so renaming them breaks the route silently.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Canonical address for search engines and shared links; unset means production (K-125).
# NUXT_PUBLIC_SITE_URL=
