{
  "name": "proscenium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": ["site"],
  "scripts": {
    "postinstall": "bun run generate && nuxt prepare",
    "generate": "bun scripts/generate.ts",
    "dev": "bun run generate && nuxt dev",
    "build": "bun run generate && nuxt build",
    "preview": "wrangler dev --cwd .output --port 8787 --test-scheduled --persist-to ../.wrangler/state --var PROSCENIUM_AUTO_MIGRATE:1",
    "deploy": "wrangler deploy",
    "check": "bun run lint && bun run typecheck && bun run check:conformance",
    "check:conformance": "bun scripts/check.ts",
    "check:paths": "bun scripts/check-owned-paths.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tests/types/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "PROSCENIUM_GALLERY=1 bun run build && playwright test",
    "db:generate": "bun scripts/db-generate.ts",
    "search:drop": "bun scripts/search-indexes.ts drop",
    "search:make": "bun scripts/search-indexes.ts make",
    "verify": "bun run check && bun run test && bun run test:browser"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.3",
    "@dnd-kit/collision": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/vue": "^0.5.3",
    "@iconify-json/lucide": "^1.2.155",
    "@internationalized/date": "3.12.4",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "^4.13.0",
    "@nuxtjs/turnstile": "^1.1.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@tanstack/charts": "^1.5.0",
    "@vueuse/core": "^15.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "h3": "1.15.11",
    "jiti": "^2.6.1",
    "jsqr": "1.4.0",
    "lru-cache": "^11.2.6",
    "nitro": "^3.0.261103-rc",
    "nuxt": "4.7.0",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "2.11.0",
    "tailwindcss": "^4.3.5",
    "uqr": "0.1.2",
    "vue": "^3.5.46",
    "vue-router": "^5.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/kit": "4.7.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "typescript": "~5.9",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "4.162.0"
  },
  "trustedDependencies": ["esbuild", "workerd", "@parcel/watcher", "better-sqlite3"]
}
