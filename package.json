{
  "name": "nnt-unified",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "check:comments": "bun scripts/check-comments.ts",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:content-tokens": "bun scripts/check-content-tokens.ts",
    "migration:export": "./migration/export.sh",
    "migration:dry-run": "bun migration/inventory.ts && bun migration/transform-identity.ts && bun migration/reconcile.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "3.15.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.0",
    "@nuxthub/core": "0.10.8",
    "@nuxtjs/seo": "5.3.14",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-authorization": "0.3.5",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "1.4.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.10",
    "wrangler": "4.126.0"
  },
  "overrides": {
    "h3": "^1.15.11",
    "@nuxt/schema": "^4.5.2"
  }
}
